#!/usr/bin/env node
/**
 * MOMO CODE v2.0 — CLI Entry Point
 *
 * Converged entry: Pi-based REPL agent for interactive mode,
 * legacy Node.js handlers for built-in subcommands.
 */

import { spawn } from "child_process"
import { existsSync, readFileSync } from "fs"
import { dirname, join } from "path"
import { fileURLToPath } from "url"

const __dirname = dirname(fileURLToPath(import.meta.url))

// ── Built-in commands handled by the legacy Node.js CLI ────────────
const LEGACY_COMMANDS = new Set([
  "models",
  "/optim",
  "optim",
  "/serve",
  "serve",
  "/evolve",
  "/fine-tune",
  "/finetune",
  "evolve",
  "fine-tune",
  "finetune",
  "/setup",
  "setup",
  "web",
  "repl",
  "gui-bridge",
  "help",
  "--help",
  "-h",
  "version",
  "--version",
  "-v",
])

function isLegacyCommand(argv) {
  if (argv.length === 0) return false
  const first = argv[0]
  if (first.startsWith("/")) return true
  if (first === "-p" || first === "--provider") return true
  return LEGACY_COMMANDS.has(first)
}

// ── Argument parsing ──────────────────────────────────────────────
function parseArgs(argv) {
  if (isLegacyCommand(argv)) {
    return { mode: "legacy", legacyArgv: argv }
  }

  if (argv[0] === "exec" || argv[0] === "--exec") {
    const next = argv[1]
    if (next === "--json") {
      return { mode: "json", prompt: argv.slice(2).join(" "), legacyArgv: [] }
    }
    return { mode: "print", prompt: argv.slice(1).join(" "), legacyArgv: [] }
  }

  if (argv[0] === "--json") {
    return { mode: "json", prompt: argv.slice(1).join(" "), legacyArgv: [] }
  }

  if (argv.length === 0) {
    return { mode: "repl", legacyArgv: [] }
  }

  return { mode: "repl", prompt: argv.join(" "), legacyArgv: [] }
}

// ── Run legacy Node.js CLI ────────────────────────────────────────
function runLegacy(argv) {
  return import("../dist/cli/index.js")
    .then(({ runCli }) => runCli(argv))
    .catch((err) => {
      if (err.code === "ERR_MODULE_NOT_FOUND" || err.message?.includes("Cannot find module")) {
        console.error("\x1b[31mError:\x1b[0m Build output not found or ESM import broken.")
        console.error("Original error:", err.message)
        console.error("Try: npm run build")
      } else {
        console.error(`\x1b[31mError:\x1b[0m ${err.message}`)
        if (err.stack) console.error(err.stack)
      }
      process.exit(1)
    })
}

// ── Run Pi agent (REPL / print / json) ────────────────────────────
async function runPiAgent(args) {
  // Check for the built runtime up front: a dev checkout that has not run
  // `npm run build` must fail loudly instead of being misreported as
  // "Pi runtime not installed" and silently degrading to the native REPL.
  if (!existsSync(join(__dirname, "..", "dist", "pi-runtime.js"))) {
    console.error("\x1b[31mError:\x1b[0m Build output not found (dist/pi-runtime.js).")
    console.error("Try: npm run build")
    process.exit(1)
  }

  try {
    const { InteractiveMode } = await import("@earendil-works/pi-coding-agent")
    const { createMomoRuntime, runMomoPrint } = await import("../dist/pi-runtime.js")
    const runtime = await createMomoRuntime()
    if (args.mode === "repl" && process.stdin.isTTY) {
      await new InteractiveMode(runtime, { initialMessage: args.prompt }).run()
    } else {
      process.exitCode = await runMomoPrint(runtime, args.mode === "json" ? "json" : "text", args.prompt)
    }
  } catch (err) {
    if (err.code === "ERR_MODULE_NOT_FOUND" || err.message?.includes("Cannot find module")) {
      console.warn("⚠️  Pi runtime not installed. Using momo native REPL.")
      console.warn("   Install Pi: npm install @earendil-works/pi-coding-agent@1.4.0")
      console.warn("")
      await runNativeRepl(args)
    } else {
      throw err
    }
  }
}

// ── Native REPL fallback (no Pi required) ─────────────────────────
async function runNativeRepl(args) {
  // Use tsx to run the TypeScript REPL directly. Spawn without a shell so
  // prompts containing spaces survive argv intact (and no DEP0190 warning).
  const npx = process.platform === "win32" ? "npx.cmd" : "npx"
  const tsx = spawn(
    npx,
    ["tsx", "src/repl/index.ts", args.mode, args.prompt || ""],
    {
      cwd: join(__dirname, ".."),
      stdio: "inherit",
    }
  )

  return new Promise((resolve, reject) => {
    tsx.on("close", (code) => {
      if (code === 0) resolve()
      else reject(new Error(`REPL exited with code ${code}`))
    })
  })
}

// ── Version ───────────────────────────────────────────────────────
function showVersion() {
  try {
    const pkg = JSON.parse(readFileSync(join(__dirname, "..", "package.json"), "utf8"))
    console.log(pkg.version || "0.1.0")
  } catch {
    console.log("0.1.0")
  }
}

